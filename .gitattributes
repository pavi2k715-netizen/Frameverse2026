# Normalize line endings: store LF in the repo, check out per-OS.
* text=auto

# Windows scripts should always use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts should stay LF.
*.sh text eol=lf

# Binary assets — never modify.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
